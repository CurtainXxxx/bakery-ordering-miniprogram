/* pages/orders/orders.wxss */
.orders-container {
  padding: 16px;
  padding-bottom: 120rpx;
}
.order-card {
  background: white;
  border-radius: 16px;
  margin-bottom: 16px;
  overflow: hidden;
}
.order-header {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
  background-color: #faf9f8;
  border-bottom: 1px solid #eee;
}
.order-no {
  font-size: 14px;
  font-weight: bold;
}
.order-status {
  font-size: 14px;
  color: #d4a373;
}
.order-status.cancelled {
  color: #999;
}
.order-info {
  display: flex;
  justify-content: space-between;
  padding: 8px 16px;
  background-color: #fefefe;
  font-size: 12px;
  color: #999;
}
.order-address {
  background-color: #f0f8ff;
  padding: 12px 16px;
  margin: 0 16px 8px 16px;
  border-radius: 8px;
}
.address-title {
  font-weight: bold;
  margin-bottom: 8px;
  font-size: 14px;
  color: #2c3e50;
}
.address-detail text {
  display: block;
  font-size: 13px;
  margin-bottom: 4px;
  color: #555;
}
.order-remark {
  background-color: #fef9e6;
  padding: 8px 16px;
  margin: 0 16px 8px 16px;
  border-radius: 8px;
  font-size: 14px;
  color: #856404;
}
.remark-label {
  font-weight: bold;
  margin-right: 8px;
}
.remark-content {
  word-break: break-all;
}
.order-items {
  padding: 8px 16px;
}
.order-item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #f0f0f0;
}
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  border-top: 1px solid #eee;
  background-color: #faf9f8;
}
.total {
  font-weight: bold;
  color: #e67e22;
}
.order-buttons {
  display: flex;
  gap: 8px;
}
.empty {
  text-align: center;
  padding: 60px 0;
  color: #999;
}