/* pages/admin-login/admin-login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8f0e3 0%, #f5e6d3 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 30px;
}
.logo-area {
  text-align: center;
  margin-bottom: 60px;
}
.logo {
  font-size: 80px;
  display: block;
}
.title {
  font-size: 24px;
  font-weight: bold;
  color: #d4a373;
  margin-top: 16px;
  display: block;
}
.form {
  width: 100%;
  background: white;
  border-radius: 30px;
  padding: 30px 24px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}
.input-group {
  display: flex;
  align-items: center;
  border-bottom: 1px solid #eee;
  margin-bottom: 24px;
  padding: 8px 0;
}
.input-group .icon {
  font-size: 20px;
  margin-right: 12px;
}
.input-group input {
  flex: 1;
  padding: 8px 0;
  font-size: 16px;
}
.eye {
  font-size: 18px;
  padding: 0 8px;
}
button {
  margin-top: 20px;
  background-color: #d4a373;
  color: white;
  border-radius: 40px;
  padding: 12px;
}
.forget {
  text-align: center;
  margin-top: 20px;
  font-size: 14px;
  color: #999;
}
.footer {
  position: fixed;
  bottom: 30px;
  color: #ccc;
  font-size: 12px;
}