<!-- pages/admin-login/admin-login.wxml -->
<view class="container">
  <view class="logo-area">
    <text class="logo">🍞</text>
    <text class="title">商家管理登录</text>
  </view>

  <view class="form">
    <view class="input-group">
      <text class="icon">👤</text>
      <input placeholder="请输入账号" bindinput="onAccountInput" value="{{account}}" />
    </view>
    <view class="input-group">
      <text class="icon">🔒</text>
      <input placeholder="请输入密码" bindinput="onPasswordInput" value="{{password}}" password="{{!showPassword}}" />
      <text class="eye" bindtap="togglePassword">{{showPassword ? '👁️' : '🙈'}}</text>
    </view>
    <button type="primary" bindtap="login">登录</button>
    <view class="forget" bindtap="forgetPassword">忘记密码？</view>
  </view>

  <view class="footer">
    <text>仅商家管理员可登录</text>
  </view>
</view>