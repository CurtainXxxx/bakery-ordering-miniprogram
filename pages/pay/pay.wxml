<!-- pages/pay/pay.wxml -->
<view class="pay-container">
  <view class="order-info">
    <text class="order-no">订单号：{{order.orderNo}}</text>
    <text class="order-amount">金额：¥{{totalPrice}}</text>
  </view>

  <view class="qrcode-section">
    <image wx:if="{{paymentCodeUrl}}" class="qrcode-img" src="{{paymentCodeUrl}}" mode="widthFix" show-menu-by-longpress="true" bindtap="previewPaymentCode"></image>
    <view wx:else class="no-code">暂未设置支付码，请联系商家</view>
    <view class="qrcode-tip">长按图片识别二维码</view>
    <view class="qrcode-tip">支付后请点击下方按钮</view>
  </view>

  <view class="action-buttons">
    <button class="confirm-btn" bindtap="confirmPayment">我已付款</button>
    <button class="cancel-btn" bindtap="cancelPay">返回</button>
  </view>
</view>