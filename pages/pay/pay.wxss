/* pages/pay/pay.wxss */
.pay-container {
  padding: 30px;
  background-color: #f9f9f9;
  min-height: 100vh;
}
.order-info {
  background: white;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 30px;
  text-align: center;
}
.order-no {
  font-size: 14px;
  color: #666;
  display: block;
  margin-bottom: 10px;
}
.order-amount {
  font-size: 28px;
  font-weight: bold;
  color: #e67e22;
}
.qrcode-section {
  background: white;
  border-radius: 16px;
  padding: 30px;
  text-align: center;
  margin-bottom: 30px;
}
.qrcode-img {
  width: 220px;
  margin: 0 auto;
  display: block;
  border-radius: 12px;
}
.no-code {
  padding: 60px 0;
  color: #999;
  font-size: 14px;
}
.qrcode-tip {
  font-size: 12px;
  color: #999;
  margin-top: 12px;
}
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.confirm-btn {
  background-color: #d4a373;
  color: white;
  border-radius: 40px;
  height: 48px;
  line-height: 48px;
  font-size: 16px;
}
.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 40px;
  height: 48px;
  line-height: 48px;
  font-size: 16px;
}