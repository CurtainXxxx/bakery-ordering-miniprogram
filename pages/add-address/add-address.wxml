<!-- pages/add-address/add-address.wxml -->
<view class="container">
  <view class="form-item">
    <text>联系人</text>
    <input placeholder="请输入姓名" bindinput="onNameInput" value="{{name}}" />
  </view>
  <view class="form-item">
    <text>电话</text>
    <input type="number" placeholder="请输入手机号" bindinput="onPhoneInput" value="{{phone}}" />
  </view>
  
  <!-- 所在地区选择器，未选择时显示"请选择" -->
  <view class="form-item">
    <text>所在地区</text>
    <picker mode="region" bindchange="onRegionChange" value="{{region}}">
      <view class="picker {{region[0] ? '' : 'placeholder'}}">
        {{region[0] ? region[0] + ' ' + region[1] + ' ' + region[2] : '请选择省市区'}}
      </view>
    </picker>
  </view>
  
  <view class="form-item">
    <text>详细地址</text>
    <textarea placeholder="请输入街道、门牌号等详细信息" bindinput="onDetailInput" value="{{detail}}" />
  </view>
  
  <view class="form-item">
    <text>设为默认地址</text>
    <switch checked="{{isDefault}}" bindchange="onDefaultChange" />
  </view>
  
  <button type="primary" bindtap="submit">保存地址</button>
</view>