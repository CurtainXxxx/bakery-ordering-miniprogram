/* pages/add-address/add-address.wxss */
.container {
  padding: 20px;
  background-color: #f9f9f9;
  min-height: 100vh;
}
.form-item {
  margin-bottom: 24px;
}
.form-item text {
  display: block;
  font-weight: bold;
  margin-bottom: 10px;
  font-size: 16px;
  color: #333;
}
input, textarea, .picker {
  width: 100%;
  padding: 14px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  font-size: 16px;
  box-sizing: border-box;
  background-color: #fff;
  line-height: 1.5;
}
input:focus, textarea:focus {
  border-color: #d4a373;
  outline: none;
}
input {
  height: 48px;
}
textarea {
  min-height: 100px;
  resize: none;
}
.picker {
  background-color: #f5f5f5;
  height: 48px;
  line-height: 48px;
  padding: 0 12px;
  color: #333;
}
/* 占位符样式 */
.picker.placeholder {
  color: #999;
}
button {
  margin-top: 30px;
  background-color: #d4a373;
  color: white;
  border-radius: 40px;
  height: 48px;
  line-height: 48px;
  font-size: 16px;
  font-weight: 500;
  border: none;
}
button:active {
  opacity: 0.8;
}