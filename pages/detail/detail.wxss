/* pages/detail/detail.wxss */
.detail-container {
  padding: 20px;
}
.detail-image {
  width: 100%;
  background-color: #f8f0e3;
  border-radius: 30px;
  overflow: hidden;
  margin-bottom: 30px;
}
.detail-image image {
  width: 100%;
  display: block;
}
.detail-emoji {
  font-size: 200px;
  text-align: center;
  padding: 40px 0;
}
.detail-info {
  margin-bottom: 30px;
}
.detail-name {
  font-size: 24px;
  font-weight: bold;
  display: block;
  margin-bottom: 10px;
}
.detail-price {
  font-size: 28px;
  color: #e67e22;
  display: block;
  margin-bottom: 20px;
}
.detail-desc {
  font-size: 14px;
  color: #666;
  line-height: 1.5;
  display: block;
}
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px;
  background: white;
  border-top: 1px solid #eee;
}
.buy-btn {
  background-color: #d4a373;
  color: white;
  width: 100%;
  border-radius: 30px;
}