.container {
  padding: 20px;
  background-color: #f9f9f9;
  min-height: 100vh;
}
.form-item {
  margin-bottom: 24px;
}
.form-item text {
  display: block;
  font-weight: bold;
  margin-bottom: 10px;
  font-size: 16px;
  color: #333;
}
input, textarea, .picker {
  width: 100%;
  padding: 14px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  font-size: 16px;
  box-sizing: border-box;
  background-color: #fff;
  line-height: 1.5;
  transition: all 0.3s;
}
input:focus, textarea:focus {
  border-color: #d4a373;
  outline: none;
}
input {
  height: 48px;
}
textarea {
  min-height: 100px;
  resize: none;
}
.picker {
  background-color: #f5f5f5;
  height: 48px;
  line-height: 48px;
  padding: 0 12px;
  color: #333;
}
.image-upload {
  width: 100%;
  min-height: 200px;
  background-color: #f5f5f5;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px dashed #ddd;
  cursor: pointer;
  transition: all 0.3s;
}
.image-upload image {
  width: 100%;
  height: 200px;
  object-fit: cover;
}
.upload-placeholder {
  text-align: center;
  padding: 40px 20px;
  color: #999;
  font-size: 14px;
}
.upload-tip {
  display: block;
  font-size: 12px;
  margin-top: 8px;
  color: #bbb;
}
.image-actions {
  margin-top: 12px;
  display: flex;
  justify-content: flex-end;
  gap: 12px;
}
button {
  margin-top: 30px;
  background-color: #d4a373;
  color: white;
  border-radius: 40px;
  height: 48px;
  line-height: 48px;
  font-size: 16px;
  font-weight: 500;
  border: none;
}
button:active {
  opacity: 0.8;
}