<!-- pages/admin/product-edit/product-edit.wxml -->
<view class="container">
  <view class="form-item">
    <text>商品名称</text>
    <input placeholder="请输入商品名称" bindinput="onNameInput" value="{{name}}" />
  </view>
  <view class="form-item">
    <text>价格</text>
    <input type="digit" placeholder="请输入价格" bindinput="onPriceInput" value="{{price}}" />
  </view>
  <view class="form-item">
    <text>分类</text>
    <picker range="{{categories}}" bindchange="onCategoryChange" value="{{categories.indexOf(category)}}">
      <view class="picker">{{category}}</view>
    </picker>
  </view>
  <view class="form-item">
    <text>商品描述</text>
    <textarea placeholder="请输入商品描述" bindinput="onDescInput" value="{{desc}}" />
  </view>

  <view class="form-item">
    <text>商品图片</text>
    <view class="image-upload" bindtap="chooseImage">
      <image wx:if="{{tempImageUrl || imageUrl}}" src="{{tempImageUrl || imageUrl}}" mode="aspectFill" bindtap="previewImage"></image>
      <view wx:else class="upload-placeholder">
        <text>+ 点击上传图片</text>
        <text class="upload-tip">支持 jpg/png，建议 750x750</text>
      </view>
    </view>
    <view wx:if="{{tempImageUrl || imageUrl}}" class="image-actions">
      <button size="mini" type="default" bindtap="previewImage">预览</button>
      <button size="mini" type="warn" bindtap="deleteImage">删除图片</button>
    </view>
  </view>

  <view class="form-item">
    <text>上架状态</text>
    <switch checked="{{isOnSale}}" bindchange="onSaleChange" />
  </view>

  <view class="form-item">
    <text>招牌商品</text>
    <switch checked="{{isFeatured}}" bindchange="onFeaturedChange" />
    <text class="tip" style="font-size:12px; color:#999; margin-left:12px;">设为招牌后，商品名前会显示🔥标识</text>
  </view>

  <view class="form-item">
    <text>月销售量</text>
    <text class="sales-value">{{monthSales}} 件</text>
  </view>

  <button type="primary" bindtap="submit">保存</button>
</view>