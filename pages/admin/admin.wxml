<!-- pages/admin/admin.wxml -->
<view class="container">
  <view class="logout-btn" bindtap="logout">退出</view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-label">今日订单</text>
      <text class="stat-value">{{todayCount}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">今日营业额</text>
      <text class="stat-value">¥{{todayTotal}}</text>
    </view>
    <view class="stat-item">
      <text class="stat-label">本月营业额</text>
      <text class="stat-value">¥{{monthTotal}}</text>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'orders' ? 'active' : ''}}" bindtap="switchTab" data-tab="orders">📋 订单管理</view>
    <view class="tab-item {{activeTab === 'products' ? 'active' : ''}}" bindtap="switchTab" data-tab="products">🍞 商品管理</view>
    <view class="tab-item {{activeTab === 'shop' ? 'active' : ''}}" bindtap="switchTab" data-tab="shop">🏪 店铺设置</view>
    <view class="tab-item {{activeTab === 'payment' ? 'active' : ''}}" bindtap="switchTab" data-tab="payment">💳 支付码管理</view>
  </view>

  <!-- 订单管理 -->
  <block wx:if="{{activeTab === 'orders'}}">
    <view class="filter-bar">
  <view class="filter-item {{statusFilter === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="all">全部</view>
  <view class="filter-item {{statusFilter === '待支付' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="待支付">待支付 <text class="count-badge pending-pay">{{countPendingPay}}</text></view>
  <view class="filter-item {{statusFilter === '待确认' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="待确认">待确认 <text class="count-badge pending-confirm">{{countPendingConfirm}}</text></view>
  <view class="filter-item {{statusFilter === '已确认' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="已确认">已确认 <text class="count-badge confirmed">{{countConfirmed}}</text></view>
  <view class="filter-item {{statusFilter === '已完成' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="已完成">已完成 <text class="count-badge completed">{{countCompleted}}</text></view>
  <view class="filter-item {{statusFilter === '已取消' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="已取消">已取消 <text class="count-badge cancelled">{{countCancelled}}</text></view>
</view>

    <view class="order-list">
      <block wx:for="{{orders}}" wx:key="_id">
        <view class="order-card">
          <view class="order-header">
            <text class="order-no">{{item.orderNo}}</text>
            <text class="order-status {{item.status === '待支付' ? 'pending' : ''}} {{item.status === '待确认' ? 'pending' : ''}} {{item.status === '已确认' ? 'confirmed' : ''}} {{item.status === '已完成' ? 'completed' : ''}} {{item.status === '已取消' ? 'cancelled' : ''}}">{{item.status}}</text>
          </view>
          <view class="order-info">
            <text>配送：{{item.deliveryType === 'pickup' ? '自取' : '配送'}}</text>
            <text>{{item.createTime}}</text>
          </view>
          <view wx:if="{{item.remark}}" class="order-remark">
            <text class="remark-label">备注：</text>
            <text class="remark-content">{{item.remark}}</text>
          </view>
          <view wx:if="{{item.deliveryType === 'delivery' && item.address}}" class="order-address">
            <view class="address-title">收货信息</view>
            <view class="address-detail">
              <text>联系人：{{item.address.name}}</text>
              <text>电话：{{item.address.phone}}</text>
              <text>地址：{{item.address.province}}{{item.address.city}}{{item.address.district}}{{item.address.detail}}</text>
            </view>
          </view>
          <view class="order-items">
            <block wx:for="{{item.items}}" wx:key="productId">
              <view class="order-item">
                <text>{{item.name}} x {{item.quantity}}</text>
                <text>¥{{item.price * item.quantity}}</text>
              </view>
            </block>
          </view>
          <view class="order-footer">
            <text class="total">合计：¥{{item.totalPrice}}</text>
            <button wx:if="{{item.status !== '已完成' && item.status !== '已取消'}}" size="mini" type="primary" bindtap="updateOrderStatus" data-id="{{item._id}}" data-current-status="{{item.status}}">更新状态</button>
            <text wx:else class="done">{{item.status === '已取消' ? '已取消' : '已完成'}}</text>
          </view>
        </view>
      </block>
      <view wx:if="{{orders.length === 0}}" class="empty">暂无订单</view>
    </view>
  </block>

  <!-- 商品管理 -->
  <block wx:if="{{activeTab === 'products'}}">
    <view class="product-header">
      <button type="primary" size="mini" bindtap="editProduct">+ 新增商品</button>
    </view>
    <view class="product-list">
      <block wx:for="{{products}}" wx:key="_id">
        <view class="product-card">
          <view class="product-image">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
            <view wx:else class="product-emoji">{{item.emoji}}</view>
          </view>
          <view class="product-info">
            <view class="product-name-row">
              <text class="name-text">{{item.name}}</text>
              <text wx:if="{{item.isFeatured}}" class="featured-tag">🔥 招牌</text>
            </view>
            <view class="product-sales">月销 {{item.monthSales || 0}} 件</view>
            <text class="product-price">¥{{item.price}}</text>
            <text class="product-desc">{{item.desc}}</text>
            <view class="product-actions">
              <button size="mini" type="default" bindtap="editProduct" data-id="{{item._id}}">编辑</button>
              <button size="mini" type="warn" bindtap="deleteProduct" data-id="{{item._id}}" data-name="{{item.name}}">删除</button>
              <button size="mini" type="{{item.isOnSale ? 'default' : 'primary'}}" bindtap="toggleSale" data-id="{{item._id}}" data-current="{{item.isOnSale}}">{{item.isOnSale ? '下架' : '上架'}}</button>
            </view>
          </view>
        </view>
      </block>
      <view wx:if="{{products.length === 0}}" class="empty">暂无商品，请点击上方按钮添加</view>
    </view>
  </block>

  <!-- 店铺设置 -->
  <block wx:if="{{activeTab === 'shop'}}">
    <view class="shop-info-card">
      <view class="shop-info-header">
        <text class="shop-info-title">店铺信息</text>
        <button class="edit-btn" size="mini" bindtap="openShopEditModal">编辑</button>
      </view>
      <view class="shop-info-item">
        <text class="info-label">📍 地址：</text>
        <text class="info-value">{{shopInfo.address}}</text>
      </view>
      <view class="shop-info-item">
        <text class="info-label">💬 微信：</text>
        <view class="info-value">
          <view wx:if="{{shopInfo.wechatList[0]}}">{{shopInfo.wechatList[0]}}</view>
          <view wx:if="{{shopInfo.wechatList[1]}}">{{shopInfo.wechatList[1]}}</view>
        </view>
      </view>
      <view class="shop-info-item">
        <text class="info-label">📞 电话：</text>
        <view class="info-value">
          <view wx:if="{{shopInfo.phoneList[0]}}">{{shopInfo.phoneList[0]}}</view>
          <view wx:if="{{shopInfo.phoneList[1]}}">{{shopInfo.phoneList[1]}}</view>
        </view>
      </view>
      <view class="shop-info-item">
        <text class="info-label">⏰ 配送时间：</text>
        <view class="info-value">
          <view wx:if="{{shopInfo.deliveryTimeList[0]}}">{{shopInfo.deliveryTimeList[0]}}</view>
          <view wx:if="{{shopInfo.deliveryTimeList[1]}}">{{shopInfo.deliveryTimeList[1]}}</view>
          <view wx:if="{{shopInfo.deliveryTimeList[2]}}">{{shopInfo.deliveryTimeList[2]}}</view>
        </view>
      </view>
      <!-- 轮播图管理入口 -->
      <view class="shop-info-item">
        <text class="info-label">📸 轮播图：</text>
        <view class="info-value">
          <button class="edit-btn" size="mini" bindtap="openBannersModal">管理轮播图</button>
          <view class="banner-preview" wx:if="{{banners.length > 0}}">
            <image wx:for="{{banners}}" wx:key="index" src="{{item}}" mode="aspectFill" class="banner-thumb"></image>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 支付码管理 -->
  <block wx:if="{{activeTab === 'payment'}}">
    <view class="shop-info-card">
      <view class="shop-info-header">
        <text class="shop-info-title">支付码管理</text>
        <button class="edit-btn" size="mini" bindtap="uploadPaymentCode">上传支付码</button>
      </view>
      <view class="payment-code-preview" wx:if="{{paymentCodeUrl}}">
        <image src="{{paymentCodeUrl}}" mode="widthFix" bindtap="previewPaymentCode"></image>
        <view class="preview-tip">点击图片可预览</view>
      </view>
      <view wx:else class="no-payment-code">
        <text>暂无支付码，请点击上方按钮上传</text>
      </view>
    </view>
  </block>
</view>

<!-- 编辑店铺信息弹窗 -->
<view wx:if="{{showShopEditModal}}" class="modal-mask" bindtap="closeShopEditModal">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-title">编辑店铺信息</view>
    <view class="modal-content">
      <view class="form-item">
        <text>店铺地址</text>
        <input placeholder="请输入店铺地址" bindinput="onShopAddressInput" value="{{editShopInfo.address}}" />
      </view>
      <view class="form-item">
        <text>微信号1</text>
        <input placeholder="第一个微信号" bindinput="onWechat1Input" value="{{editShopInfo.wechatList[0]}}" />
      </view>
      <view class="form-item">
        <text>微信号2（可选）</text>
        <input placeholder="第二个微信号（可选）" bindinput="onWechat2Input" value="{{editShopInfo.wechatList[1]}}" />
      </view>
      <view class="form-item">
        <text>联系电话1</text>
        <input placeholder="第一个联系电话" bindinput="onPhone1Input" value="{{editShopInfo.phoneList[0]}}" />
      </view>
      <view class="form-item">
        <text>联系电话2（可选）</text>
        <input placeholder="第二个联系电话（可选）" bindinput="onPhone2Input" value="{{editShopInfo.phoneList[1]}}" />
      </view>
      <view class="form-item">
        <text>配送时间1</text>
        <input placeholder="例如：09:00-12:00" bindinput="onDeliveryTime1Input" value="{{editShopInfo.deliveryTimeList[0]}}" />
      </view>
      <view class="form-item">
        <text>配送时间2（可选）</text>
        <input placeholder="例如：12:00-18:00" bindinput="onDeliveryTime2Input" value="{{editShopInfo.deliveryTimeList[1]}}" />
      </view>
      <view class="form-item">
        <text>配送时间3（可选）</text>
        <input placeholder="例如：18:00-21:00" bindinput="onDeliveryTime3Input" value="{{editShopInfo.deliveryTimeList[2]}}" />
      </view>
    </view>
    <view class="modal-buttons">
      <button class="cancel-btn" bindtap="closeShopEditModal">取消</button>
      <button class="confirm-btn" bindtap="saveShopInfo">保存</button>
    </view>
  </view>
</view>

<!-- 轮播图编辑弹窗 -->
<view wx:if="{{showBannersModal}}" class="modal-mask" bindtap="closeBannersModal">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-title">轮播图管理</view>
    <view class="modal-content">
      <view class="banner-list">
        <block wx:for="{{editBanners}}" wx:key="index">
          <view class="banner-item">
            <image src="{{item}}" mode="aspectFill" class="banner-item-img"></image>
            <view class="banner-item-actions">
              <button size="mini" type="warn" bindtap="deleteBannerImage" data-index="{{index}}">删除</button>
            </view>
          </view>
        </block>
        <view class="add-banner-btn" bindtap="chooseBannerImage">
          <text>+ 添加图片</text>
        </view>
      </view>
    </view>
    <view class="modal-buttons">
      <button class="cancel-btn" bindtap="closeBannersModal">取消</button>
      <button class="confirm-btn" bindtap="saveBanners">保存</button>
    </view>
  </view>
</view>