/* pages/address/address.wxss */
.address-container {
  padding: 16px;
  padding-bottom: 100px;
}
.address-list {
  margin-bottom: 20px;
}
.address-item {
  background: white;
  padding: 16px;
  border-radius: 16px;
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.info {
  flex: 1;
}
.info text {
  display: block;
}
.info text:first-child {
  font-weight: bold;
  margin-bottom: 8px;
}
.info text:last-child {
  color: #666;
}
.default-tag {
  background-color: #d4a373;
  color: white;
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
}
.address-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12px;
}
.address-actions button {
  margin-left: 8px;
}
.empty {
  text-align: center;
  padding: 60px 0;
  color: #999;
}
.add-btn {
  background-color: #d4a373;
  color: white;
  border-radius: 30px;
  width: 80%;
  margin: 0 auto;
}