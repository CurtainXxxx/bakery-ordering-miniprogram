/* pages/order/order.wxss */
.order-container {
  padding: 20px;
}
.delivery-type, .address-info, .items-list, .total, .remark {
  background: white;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
}
.address-title {
  font-weight: bold;
  margin-bottom: 12px;
  font-size: 16px;
}
.address-detail text {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  color: #333;
}
.order-item {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}
.item-emoji {
  width: 50px;
  height: 50px;
  background-color: #f8f0e3;
  border-radius: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-right: 16px;
}
.item-info {
  flex: 1;
}
.total {
  text-align: right;
  font-weight: bold;
  font-size: 18px;
}
.remark textarea {
  width: 100%;
  height: 80px;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
}
/* 支付码弹窗样式 */
.payment-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.payment-modal-container {
  width: 85%;
  background: white;
  border-radius: 24px;
  overflow: hidden;
}
.payment-modal-title {
  padding: 20px;
  text-align: center;
  font-size: 18px;
  font-weight: bold;
  background-color: #faf9f8;
  border-bottom: 1px solid #eee;
}
.payment-modal-content {
  padding: 24px;
  text-align: center;
}
.payment-qrcode {
  width: 200px;
  height: 200px;
  margin: 0 auto;
  display: block;
  border-radius: 12px;
}
.no-payment-code-tip {
  padding: 40px 0;
  color: #999;
  font-size: 14px;
}
.payment-amount {
  font-size: 20px;
  font-weight: bold;
  color: #e67e22;
  margin: 16px 0 12px;
}
.payment-tip {
  font-size: 12px;
  color: #999;
  margin-bottom: 8px;
}
.payment-confirm-btn {
  background-color: #d4a373;
  color: white;
  border-radius: 40px;
  margin: 20px 0 12px;
  height: 44px;
  line-height: 44px;
  font-size: 16px;
}
.payment-cancel {
  font-size: 14px;
  color: #999;
  padding: 10px;
}
/* 运费信息样式 */
.fee-info {
  background: white;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 16px;
}
.fee-row, .total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  font-size: 14px;
}
.fee-value {
  color: #e67e22;
}
.fee-value.has-fee {
  font-weight: bold;
}
.fee-rule {
  color: #999;
  font-size: 12px;
  margin-left: 8px;
}
.total-row {
  border-top: 1px solid #eee;
  padding-top: 8px;
  margin-top: 8px;
  font-weight: bold;
  font-size: 16px;
}
.total-price {
  color: #e67e22;
  font-size: 18px;
}
/* 运费规则弹窗（复用之前的 modal 样式，可简单调整） */
.rule-text {
  font-size: 14px;
  color: #333;
  margin-bottom: 12px;
  line-height: 1.5;
}