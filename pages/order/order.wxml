<!-- pages/order/order.wxml -->
<view class="order-container">
  <view class="delivery-type">
    <text>配送方式：</text>
    <text>{{deliveryType === 'pickup' ? '自取' : '配送'}}</text>
  </view>

  <view wx:if="{{deliveryType === 'delivery' && address}}" class="address-info">
    <view class="address-title">收货信息</view>
    <view class="address-detail">
      <text>联系人：{{address.name}}</text>
      <text>电话：{{address.phone}}</text>
      <text>地址：{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
    </view>
  </view>

  <view class="items-list">
    <block wx:for="{{items}}" wx:key="productId">
      <view class="order-item">
        <view class="item-emoji">{{item.emoji}}</view>
        <view class="item-info">
          <text>{{item.name}}</text>
          <text>x{{item.quantity}}</text>
        </view>
        <text>¥{{item.price * item.quantity}}</text>
      </view>
    </block>
  </view>

  <view class="total">总计：¥{{totalPrice}}</view>
<!-- 在原有 total 下方添加 -->
<view class="fee-info" wx:if="{{deliveryType === 'delivery'}}">
  <view class="fee-row">
    <text>商品金额：</text>
    <text>¥{{originalTotal}}</text>
  </view>
  <view class="fee-row" bindtap="showShippingTip">
    <text>运费：</text>
    <text class="fee-value {{shippingFee > 0 ? 'has-fee' : ''}}">¥{{shippingFee}}</text>
    <text class="fee-rule">（点击查看运费规则）</text>
  </view>
  <view class="total-row">
    <text>总计：</text>
    <text class="total-price">¥{{totalPrice}}</text>
  </view>
</view>

<!-- 原有的 total 区域（自取时显示原价） -->
<view class="total" wx:else>总计：¥{{originalTotal}}</view>

<!-- 运费规则弹窗 -->
<view wx:if="{{showShippingTip}}" class="modal-mask" bindtap="closeShippingTip">
  <view class="modal-container" catchtap="stopPropagation">
    <view class="modal-title">运费规则</view>
    <view class="modal-content">
      <view class="rule-text">· 偏北地区（东北、华北、西北等）满88元包邮，不满加10元运费。</view>
      <view class="rule-text">· 偏南地区（华东、华南、西南等）满108元包邮，不满加13元运费。</view>
      <view class="rule-text">· 具体包邮门槛以收货地址所在省份为准。</view>
    </view>
    <view class="modal-buttons">
      <button class="confirm-btn" bindtap="closeShippingTip">知道了</button>
    </view>
  </view>
</view>
  <view class="remark">
    <textarea placeholder="备注（选填）" bindinput="onRemarkInput" value="{{remark}}"></textarea>
  </view>

  <button type="primary" bindtap="submitOrder">提交订单</button>
</view>

<!-- 支付码弹窗 -->
<view wx:if="{{showPaymentModal}}" class="payment-modal-mask" bindtap="closePaymentModal">
  <view class="payment-modal-container" catchtap="stopPropagation">
    <view class="payment-modal-title">扫码支付</view>
    <view class="payment-modal-content">
      <!-- 添加 show-menu-by-longpress="true" 支持长按识别二维码 -->
      <image wx:if="{{paymentCodeUrl}}" class="payment-qrcode" src="{{paymentCodeUrl}}" mode="widthFix" bindtap="previewPaymentCode" show-menu-by-longpress="true"></image>
      <view wx:else class="no-payment-code-tip">暂未设置支付码，请联系商家</view>
      <view class="payment-amount">支付金额：¥{{totalPrice}}</view>
      <view class="payment-tip">长按图片识别二维码</view>
      <view class="payment-tip">支付后请点击下方按钮</view>
      <button class="payment-confirm-btn" bindtap="confirmPayment">我已付款</button>
      <view class="payment-cancel" bindtap="closePaymentModal">取消</view>
    </view>
  </view>
</view>