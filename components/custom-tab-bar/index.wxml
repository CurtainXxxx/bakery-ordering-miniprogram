<!-- components/custom-tab-bar/index.wxml -->
<view class="custom-tab-bar">
  <view 
    wx:for="{{list}}" 
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    bindtap="switchTab"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
  >
    <view class="tab-icon-wrapper">
      <view class="tab-icon">{{selected === index ? item.selectedIcon : item.icon}}</view>
      <view wx:if="{{index === 1 && cartCount > 0}}" class="badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
    </view>
    <view class="tab-text">{{item.text}}</view>
  </view>
</view>